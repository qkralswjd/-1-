        "x": 100,
        "y": 200,
        "width": 800,
        "height": 500
    },

    "capture": {
        "capture_fps": 30,
        "detection_fps": 15
    },

    "detection": {
        "mode": "motion",

        "motion": {
            "diff_threshold": 20,
            "min_area": 800,
            "max_area": 40000,
