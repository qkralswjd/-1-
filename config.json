    "tracking": {
        "tracking_distance": 100,
        "missing_frames_tolerance": 5
    },

    "attack": {
        "attack_cooldown": 0.5,
        "click_duration": 0.05
    },

    "controller": {
        "type": "pico",
        "port": "COM3",
        "baudrate": 115200,
        "enabled": false
    },

    "reference_point": {
        "x": 960,
        "y": 540
    },

    "debug": {
        "show_confidence": true,
        "show_ids": true,
        "show_fps": true,
        "show_roi": true
    }
